function character_user_job_setup()
	-- Options: Override default values
    state.OffenseMode:options('Normal','Acc')
    state.WeaponskillMode:options('Match','Normal','Acc')
    state.HybridMode:options('Normal','Hybrid','PDT','MDT')
    state.PhysicalDefenseMode:options('PDT', 'HP')
	state.MagicalDefenseMode:options('MDT')
	state.ResistDefenseMode:options('MEVA')
	state.IdleMode:options('Normal', 'PDT')
	state.Weapons:options('Godhands','Sagitta','Staff','Karambit','ProcStaff','ProcClub','Knuckles','Hoxne','None')
	state.WeaponSets:options('Default','Sortie')

    weapon_sets = {
        ['Sortie'] = {'Godhands','Sagitta','Staff','Karambit','ProcStaff','ProcClub','Knuckles','Hoxne','None'},
        ['Default'] = {'Hoxne','Knuckles'}
    }

    state.ExtraMeleeMode = M{['description']='Extra Melee Mode', 'None'}
    update_melee_groups()

	
	-- Additional local binds
	send_command('bind ^` input /ja "Boost" <me>')
	send_command('bind !` input /ja "Perfect Counter" <me>')
	send_command('bind ^backspace input /ja "Mantra" <me>')
    send_command('bind !f11 gs c cycle ExtraMeleeMode')
	send_command('bind @` gs c cycle SkillchainMode')
	
	select_default_macro_book()
end

