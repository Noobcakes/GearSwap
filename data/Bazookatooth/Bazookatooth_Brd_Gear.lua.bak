-- Select default macro book on initial load or subjob change.
function select_default_macro_book()
	set_macro_page(1, 13)
end
function job_self_command(commandArgs, eventArgs)
	local lowerCommand = commandArgs[1]:lower()
	if lowerCommand  == 'm4' then
                send_command('input /ma "Valor Minuet V" <me>; wait 5; input /ma "Valor Minuet IV" <me>; wait 5; input /ma "Shining Fantasia" <me>; wait 5; input /ma "Goblin Gavotte" <me>; wait 5; input /ma "Victory March" <me>; wait 5; input /ma "Honor March" <me>')
                add_to_chat(158,'March X2 Minuet X2')
		if state.DisplayMode.value then update_job_states()	end
	elseif lowerCommand  == 'm3mad' then
                send_command('input /ma "Valor Minuet V" <me>; wait 5; input /ma "Blade Madrigal" <me>; wait 5; input /ma "Shining Fantasia" <me>; wait 5; input /ma "Goblin Gavotte" <me>; wait 5; input /ma "Victory March" <me>; wait 5; input /ma "Honor March" <me>')
                add_to_chat(158,'Minuet 5, Blade Madrigal, March X2 ')	
	elseif lowerCommand  == 'tnam4' then
                 send_command('input /ja "Nightingale" <me>;wait 1; input /ja "Troubadour" <me>;wait 2; input /ma "Valor Minuet V" <me>; wait 5; input /ma "Valor Minuet IV" <me>; wait 5; input /ma "Shining Fantasia" <me>; wait 5; input /ma "Goblin Gavotte" <me>; wait 5; input /ma "Victory March" <me>; wait 5; input /ja "marcato" <me>; wait 1; input /ma "Honor March" <me>')
                add_to_chat(158,'TNA, March X2 Minuet X2')
		elseif lowerCommand  == 'tnam3mad' then
                send_command('input /ja "Nightingale" <me>; wait 1; input /ja "Troubadour" <me>; wait 1; input /ma "Valor Minuet V" <me>; wait 5; input /ma "Blade Madrigal" <me>; wait 5; input /ma "Shining Fantasia" <me>; wait 5; input /ma "Goblin Gavotte" <me>; wait 5; input /ma "Victory March" <me>; wait 5; input /ja "marcato" <me>; wait 1; input /ma "Honor March" <me>')
                add_to_chat(158,'Minuet 5, Blade Madrigal, March X2 ')	
	end
end